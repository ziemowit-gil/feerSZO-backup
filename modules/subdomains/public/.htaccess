# modules/subdomains/public — public_html małych subdomen (it, autodiscover, autoconfig); wszystko obsługuje index.php
Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Weryfikacja Let's Encrypt (pliki w .well-known/acme-challenge) i inne istniejące pliki idą bez zmian
  RewriteRule ^\.well-known/acme-challenge/ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !^/index\.php$
  RewriteRule ^ index.php [L,QSA]
</IfModule>
