Options -Indexes
DirectoryIndex index.php

RewriteEngine On

# ── Krótki adres mobilnego dialera: /mobilna → moduł crm/mobile ─────────────
# Alias działa na każdym hoście (szo.feer.org.pl/mobilna, crm.feer.org.pl/mobilna)
# i musi być PRZED regułami subdomen, żeby ich catch-all go nie przechwycił.
# Przepisanie jest wewnętrzne — adres w przeglądarce zostaje krótki, dzięki czemu
# service worker rejestruje się w scope /mobilna/ (patrz crm_mobile_base()).
RewriteRule ^mobilna$          /mobilna/ [R=301,L]
RewriteRule ^mobilna/$         /crm/mobile/index.php [L]
RewriteRule ^mobilna/(.+)$     /crm/mobile/$1 [L]

# ── Wybór klienta poczty: /poczta → strona rozjazdu (webmail/) ──────────────
# Publiczna strona „w czym czytam pocztę" (Outlook w przeglądarce vs Roundcube)
# ma DWA adresy: poczta.feer.org.pl (blok subdomeny niżej) oraz krótki alias
# szo.feer.org.pl/poczta. Reguła łapie tylko goły katalog („/poczta" i
# „/poczta/"), więc moduł Poczta (skanowanie korespondencji do CRM/EZD) działa
# bez zmian pod swoimi ścieżkami: /poczta/dashboard.php, /poczta/index.php itd.
# Musi być PRZED regułami subdomen, żeby ich catch-all tego nie przechwycił.
RewriteRule ^poczta/?$         /webmail/index.php [L]

# ── Zadania: dawne adresy /modules/tasks_plus/router.php/… → tasks/router.php ───
# Ekrany kalendarza/SLA/obciążenia/reguł przeniesiono do modułu tasks/. Alias
# wewnętrzny (bez przekierowania), żeby wydane prywatne linki iCal działały dalej.
RewriteRule ^modules/tasks_plus/router\.php/(.*)$ /tasks/router.php?_route=/$1 [QSA,L]

# ── Stare adresy routerów modułów …/router.php/<trasa> → …/router.php?_route=/<trasa> ─────────────
# Routery działają w trybie ?_route= (adres z „.php/” serwer traktuje jak plik). Alias wewnętrzny, żeby
# wydane wcześniej linki (e-maile, iCal, zakładki) działały dalej. Czyste adresy (/nabor, /zlecenie…) bez zmian.
RewriteRule ^((?:modules/[a-z0-9_]+|tasks)/router\.php)/(.+)$ /$1?_route=/$2 [QSA,L]

# ── Publiczne klauzule RODO: /klauzula/{slug} → modules/gdpr_clauses/public ─────
# Czysty adres do linkowania w formularzach/stopkach; /{lang} = wersja językowa
# (np. /klauzula/rekrutacja/en), ?embed=1 = wersja do iframe.
# Musi być PRZED regułami subdomen, żeby ich catch-all tego nie przechwycił.
RewriteRule ^klauzula/([a-z0-9-]{1,64})/?$ /modules/gdpr_clauses/public/clause.php?slug=$1 [QSA,L]
RewriteRule ^klauzula/([a-z0-9-]{1,64})/([a-z]{2})/?$ /modules/gdpr_clauses/public/clause.php?slug=$1&lang=$2 [QSA,L]
RewriteRule ^klauzula/([a-z0-9-]{1,64})\.pdf$ /modules/gdpr_clauses/public/pdf.php?slug=$1 [QSA,L]
RewriteRule ^klauzula/([a-z0-9-]{1,64})/([a-z]{2})\.pdf$ /modules/gdpr_clauses/public/pdf.php?slug=$1&lang=$2 [QSA,L]
# Lista opublikowanych klauzul (JSON) — import na stronę feer.org.pl/rodo
RewriteRule ^klauzule\.json$ /modules/gdpr_clauses/public/list.php [QSA,L]
# Alias bez rozszerzenia: nginx na serwerze serwuje *.json jako pliki statyczne (403),
# więc /klauzule.json nie dochodzi do tej reguły — /klauzule działa zawsze.
RewriteRule ^klauzule/?$ /modules/gdpr_clauses/public/list.php [QSA,L]

# ── Portal Usług IT: /uslugi-it/… → modules/it_portal/public (bez logowania) ──
# Linkowany z it.feer.org.pl. Edycja treści: /modules/it_portal/index.php.
# Musi być PRZED regułami subdomen, żeby ich catch-all tego nie przechwycił.
RewriteRule ^uslugi-it$ /uslugi-it/ [R=301,L]
RewriteRule ^uslugi-it/$ /modules/it_portal/public/index.php [QSA,L]
RewriteRule ^uslugi-it/uslugi/?$ /modules/it_portal/public/uslugi.php [QSA,L]
RewriteRule ^uslugi-it/dla/([a-z0-9-]{1,80})/?$ /modules/it_portal/public/uslugi.php?dla=$1 [QSA,L]
RewriteRule ^uslugi-it/uslugi/([a-z0-9-]{1,80})/?$ /modules/it_portal/public/usluga.php?k=$1 [QSA,L]
RewriteRule ^uslugi-it/uslugi/([a-z0-9-]{1,80})/([a-z0-9-]{1,80})/?$ /modules/it_portal/public/usluga.php?k=$1&a=$2 [QSA,L]
RewriteRule ^uslugi-it/komunikaty/?$ /modules/it_portal/public/komunikaty.php [QSA,L]
RewriteRule ^uslugi-it/komunikaty/([0-9]{1,9})/?$ /modules/it_portal/public/komunikaty.php?id=$1 [QSA,L]
RewriteRule ^uslugi-it/kontakt/?$ /modules/it_portal/public/kontakt.php [QSA,L]
RewriteRule ^uslugi-it/img/([a-f0-9]{20}\.(png|jpg|gif|webp))$ /modules/it_portal/public/img.php?f=$1 [QSA,L]
RewriteRule ^uslugi-it/szukaj/?$ /modules/it_portal/public/szukaj.php [QSA,L]

# ── Admin › Seedery (dane testowe): /seeder-test → modules/seeders/router.php (trasa ze ścieżki żądania) ──
RewriteRule ^seeder-test(/.*)?$  /modules/seeders/router.php [QSA,L]

# ── Nabór do grup TI: /nabor → publiczny formularz zgłoszenia (modules/ti/router.php) ──
# Krótki adres na każdym hoście (szo.feer.org.pl/nabor, ti.feer.org.pl/nabor). Trasa idzie w ?_route=
# (Router w trybie path czyta ją, gdy brak PATH_INFO); formularz po wysłaniu wraca na pełny adres routera.
# Całe /nabor/… (formularz, potwierdzenie, konto kandydata) — router bierze trasę ze ścieżki żądania.
RewriteRule ^nabor(/.*)?$        /modules/ti/router.php [QSA,L]
# Krótki adres dedykowanej strony logowania kandydata: /kandydat → /nabor/logowanie
RewriteRule ^kandydat/?$         /nabor/logowanie [R=302,L]

# ── Oświadczenia zleceniobiorcy: /zlecenie → publiczny kreator, /zlecenie/… (konto, link, obsługa) ──
# modules/zlecenie_oswiadczenie/router.php bierze trasę ze ścieżki żądania (adresy bez „router.php”).
RewriteRule ^zlecenie(/.*)?$     /modules/zlecenie_oswiadczenie/router.php [QSA,L]

# ── Działania (moduł Strategia): /dzialania → modules/strategy_actions/router.php (trasa ze ścieżki żądania) ──
# Przed regułami subdomen (crm., ti.…), żeby krótki adres działał na każdym hoście; dawne strategy/actions/*.php przekierowują tu.
RewriteRule ^dzialania(/.*)?$    /modules/strategy_actions/router.php [QSA,L]

# ── Subdomena ti*. → panele TI (kursant / dydaktyk) ─────────────────────────
# Host zaczynający się od „ti" (np. ti.feer.org.pl) WEWNĘTRZNIE serwuje panele TI
# (URL w przeglądarce zostaje czysty). Krótkie adresy:
#   ti.feer.org.pl/            → panel kursanta
#   ti.feer.org.pl/kursant     → panel kursanta
#   ti.feer.org.pl/dydaktyk    → panel dydaktyka (prowadzącego)

# /plan/<token> → publiczny plan zajęć grupy (bez logowania; token z panelu dydaktyka) — na ti.*, szo.* i kurs*.* (kursant.feer.org.pl)
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/([a-z0-9]{24})/?$ /karty30/ti/dydaktyk/planPubliczny.php?g=$1 [QSA,L]
# /plan/ (portal), /plan/grupy|prowadzacy|sale (katalogi), /plan/p/<token> (prowadzący), /plan/s/<id> (sala)
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/?$ /karty30/ti/dydaktyk/planPubliczny.php [QSA,L]
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/(grupy|prowadzacy|sale|dk)/?$ /karty30/ti/dydaktyk/planPubliczny.php?k=$1 [QSA,L]
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/p/([a-z0-9]{24})/?$ /karty30/ti/dydaktyk/planPubliczny.php?p=$1 [QSA,L]
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/s/([0-9]+)/?$ /karty30/ti/dydaktyk/planPubliczny.php?s=$1 [QSA,L]
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^plan/s/online/?$ /karty30/ti/dydaktyk/planPubliczny.php?s=online [QSA,L]
# /katalog/ i /katalog/<id> → publiczny katalog szkoleń (MSUES, modules/ti_msues; wejście w /karty30/)
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^katalog/?$ /karty30/ti/dydaktyk/katalog.php [QSA,L]
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^katalog/([0-9]+)/?$ /karty30/ti/dydaktyk/katalog.php?u=$1 [QSA,L]
# /dyzury → publiczna strona „Dyżury kierownika / Zarządu” (modules/ti_duty, wejście w /karty30/)
RewriteCond %{HTTP_HOST} ^(ti|szo|kurs)[^.]*\. [NC]
RewriteRule ^dyzury/?$ /karty30/ti/dydaktyk/dyzury.php [QSA,L]

# ── Czyste adresy paneli TI na ti*. i kurs*.: bez /karty30/ti/ w pasku adresu ──
# Panel uczestnika jest w korzeniu (ti.feer.org.pl/index.php?tab=lekcje), panel
# dydaktyka pod /dydaktyk/, logowanie pod /login.php. Stare pełne adresy (linki
# z e-maili, zakładki, APP_URL . '/karty30/ti/...' w kodzie) przekierowujemy
# na krótkie. Tylko GET/HEAD — POST (formularze, AJAX) idzie dalej bez zmian,
# a jego odpowiedź zwykle i tak przekierowuje względnie (PRG) na czysty adres.
# THE_REQUEST = pierwotna linia żądania, więc wewnętrzne przepisania niżej
# (/dydaktyk/x → /karty30/ti/dydaktyk/x) nie wpadają tu ponownie (brak pętli).
# 302, nie 301: przeglądarki nie zapamiętują go na stałe, gdyby trzeba było cofnąć.
# Funkcja tiPanelUrl() (modules/ti_panel_urls) od razu buduje krótkie adresy.
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/karty30/ti/kursant/ [NC]
RewriteRule ^karty30/ti/kursant/(.*)$ /$1 [R=302,L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/karty30/ti/dydaktyk/ [NC]
RewriteRule ^karty30/ti/dydaktyk/(.*)$ /dydaktyk/$1 [R=302,L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/karty30/ti/login\.php [NC]
RewriteRule ^karty30/ti/login\.php$ /login.php [R=302,L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/karty30/ti/konsultant\.php [NC]
RewriteRule ^karty30/ti/konsultant\.php$ /konsultant.php [R=302,L]

# /dydaktyk → wymuś końcowy ukośnik, aby ścieżki względne w panelu (login.php,
# logout.php) rozwiązywały się względem /dydaktyk/ (to nie jest panel domyślny).
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^dydaktyk$        /dydaktyk/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^dydaktyk/$       /karty30/ti/dydaktyk/index.php [L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^dydaktyk/(.+)$   /karty30/ti/dydaktyk/$1 [L]

# /kursant → jawny alias panelu kursanta (domyślnie i tak trafia tu cała subdomena).
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^kursant/?$       /karty30/ti/kursant/index.php [L]
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^kursant/(.+)$    /karty30/ti/kursant/$1 [L]

# login.php na subdomenie ti.*/kurs.* → centralny formularz logowania TI (kursant+dydaktyk).
# Musi być PRZED catch-all'em; bez tego kursant/login.php → ../login.php → catch-all
# → kursant/login.php → pętla nieskończona.
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^login\.php$ /karty30/ti/login.php [QSA,L]
# Osobne logowanie konsultantów loginem zastępczym „…-kz” (modules/ti_consultant_access): /konsultant.php i /konsultant
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteRule ^konsultant(\.php)?/?$ /karty30/ti/konsultant.php [QSA,L]

# szo.* i pozostałe hosty systemu: /login.php, /login, /logowanie, /logout.php → formularz
# w /auth/ (w korzeniu nie ma login.php — dawniej 404). crm./poczta./webmail. mają własne
# reguły niżej; ti./kurs. — reguła wyżej. Przekierowanie (302), żeby formularz i jego
# względne adresy działały z /auth/; query (np. ?redirect=) zostaje.
RewriteCond %{HTTP_HOST} !^(ti|kurs|crm|poczta|webmail)[^.]*\. [NC]
RewriteCond %{DOCUMENT_ROOT}/login.php !-f
RewriteRule ^(login\.php|login|logowanie)/?$ /auth/login.php [R=302,QSA,L]
RewriteCond %{HTTP_HOST} !^(ti|kurs|crm|poczta|webmail)[^.]*\. [NC]
RewriteCond %{DOCUMENT_ROOT}/logout.php !-f
RewriteRule ^(logout\.php|logout|wyloguj)/?$ /auth/logout.php [R=302,QSA,L]

# Pliki „obok” paneli (karty30/ti/assets/ti_skin.css, karty30/ti/ext/…, nowosci.php)
# — panele linkują do nich względnie („../assets/…”), co przy krótkich adresach
# daje /assets/ti_skin.css. Serwujemy je z karty30/ti/, o ile plik nie istnieje
# w korzeniu ani w panelu uczestnika (ten ma pierwszeństwo — catch-all niżej).
RewriteCond %{HTTP_HOST} ^(ti|kurs)[^.]*\. [NC]
RewriteCond %{REQUEST_URI} !^/karty30/ [NC]
RewriteCond %{DOCUMENT_ROOT}/$1 !-f
RewriteCond %{DOCUMENT_ROOT}/karty30/ti/kursant/$1 !-f
RewriteCond %{DOCUMENT_ROOT}/karty30/ti/$1 -f
RewriteRule ^(.+)$ /karty30/ti/$1 [L]

# Domyślnie cała subdomena ti.* serwuje panel kursanta. Wykluczamy już-przepisane
# ścieżki /karty30/ (kursant i dydaktyk — by nie zapętlić), statykę oraz /auth/
# (logowanie Microsoft 365 dla kursanta i prowadzącego — auth/ms365.php,
# auth/ms365_prowadzacy.php, callback auth/microsoft.php).
RewriteCond %{HTTP_HOST} ^ti[^.]*\. [NC]
RewriteCond %{REQUEST_URI} !^/karty30/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|contracts|assets|uploads|errors|api|newUI|tozsamosc)/ [NC]
# Moduł Rozliczenia (kierownik/dydaktyk) — własny katalog, nie ścieżka panelu kursanta
RewriteCond %{REQUEST_URI} !^/rozliczenia(/|$) [NC]
# Portal płatności (/platnosci) — wejście z panelu kursanta/rodzica jednym kliknięciem
RewriteCond %{REQUEST_URI} !^/platnosci(/|$) [NC]
# Router modułu TI (nabór do grup: /nabor → modules/ti/router.php) — publiczny, nie ścieżka panelu kursanta
RewriteCond %{REQUEST_URI} !^/modules/ti/router\.php [NC]
RewriteRule ^(.*)$ /karty30/ti/kursant/$1 [L]

# ── Subdomena kurs*. → panel kursanta TI (kurs.ngosystem.pl, kursant.feer.org.pl) ──
# Identyczny mechanizm jak ti*. (w tym wyjątek /auth/ dla logowania Microsoft
# 365); przekierowania, /dydaktyk, /kursant i login.php — wspólne reguły wyżej.
RewriteCond %{HTTP_HOST} ^kurs[^.]*\. [NC]
RewriteCond %{REQUEST_URI} !^/karty30/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|contracts|assets|uploads|errors|api|tozsamosc)/ [NC]
RewriteCond %{REQUEST_URI} !^/platnosci(/|$) [NC]
# Router modułu TI (nabór do grup: /nabor → modules/ti/router.php) — publiczny, nie ścieżka panelu kursanta
RewriteCond %{REQUEST_URI} !^/modules/ti/router\.php [NC]
RewriteRule ^(.*)$ /karty30/ti/kursant/$1 [L]

# ── Subdomena crm. → moduł CRM ──────────────────────────────────────────────
# Host crm.feer.org.pl WEWNĘTRZNIE serwuje moduł crm/ (URL w przeglądarce
# zostaje czysty, jak przy aliasie strukturaorg.). Pomijamy sam katalog modułu
# (aby nie zapętlić) oraz zasoby statyczne / strony błędów. Statyczne pliki modułów
# (np. modules/crm_inbox/view/inbox.css — wygląd Skrzynki CRM) też przepuszczamy.
RewriteCond %{HTTP_HOST} ^crm\. [NC]
RewriteCond %{REQUEST_URI} !^/crm/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|contracts|assets|uploads|errors|api)/ [NC]
RewriteCond %{REQUEST_URI} !^/modules/[A-Za-z0-9_/.-]+\.(css|js|map|png|jpe?g|gif|svg|webp|ico|woff2?|ttf)$ [NC]
# Strony spoza CRM (np. /portal.php z przełącznika modułów): jeśli pliku nie ma w crm/, a jest w katalogu
# głównym — serwujemy go z katalogu głównego zamiast 404 (jak na szo.*, ta sama sesja i uprawnienia).
# Pliki obecne w crm/ (index.php, login.php, inbox.php…) mają pierwszeństwo.
RewriteCond %{DOCUMENT_ROOT}/crm/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/$1 !-f
RewriteRule ^(.*)$ /crm/$1 [L]

# ── Subdomeny poczta. i webmail. → strona wyboru klienta poczty ─────────────
# Oba hosty (poczta.feer.org.pl, webmail.feer.org.pl) WEWNĘTRZNIE serwują
# webmail/ — publiczny rozjazd do Outlooka / Roundcube / SnappyMaila, bez
# logowania (patrz webmail/index.php). Dwie nazwy, bo jednym ludzie mówią
# „poczta", a drugim „webmail" — i żadna nie jest oczywista dla wszystkich.
# Pomijamy sam katalog (aby nie zapętlić) oraz zasoby statyczne / strony błędów.
RewriteCond %{HTTP_HOST} ^(poczta|webmail)\. [NC]
RewriteCond %{REQUEST_URI} !^/webmail/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|contracts|assets|uploads|errors|api)/ [NC]
RewriteRule ^(.*)$ /webmail/$1 [L]

# ── Subdomena strukturaorg. → katalog / struktura organizacji ───────────────
# Host strukturaorg.feer.org.pl WEWNĘTRZNIE serwuje moduł directory/ (URL w
# przeglądarce zostaje czysty, jak przy aliasach CRM / panelu TI). Pomijamy sam
# katalog modułu (aby nie zapętlić) oraz zasoby statyczne / strony błędów.
RewriteCond %{HTTP_HOST} ^strukturaorg\. [NC]
RewriteCond %{REQUEST_URI} !^/directory/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|contracts|assets|uploads|errors|api)/ [NC]
RewriteRule ^(.*)$ /directory/$1 [L]

# ── Subdomena tozsamosc. → moduł Tożsamość (Entra ID self-service) ──────────
# Host tozsamosc.feer.org.pl WEWNĘTRZNIE serwuje moduł tozsamosc/ (URL w
# przeglądarce zostaje czysty). Pomijamy sam katalog modułu (aby nie zapętlić)
# oraz zasoby statyczne / strony błędów. Ścieżki /auth/ (logowanie MS365, 2FA,
# callback) i /user/ (odzyskiwanie dostępu) muszą działać normalnie.
RewriteCond %{HTTP_HOST} ^tozsamosc\. [NC]
RewriteCond %{REQUEST_URI} !^/tozsamosc/ [NC]
RewriteCond %{REQUEST_URI} !^/(auth|user|contracts|assets|uploads|errors|api)/ [NC]
RewriteRule ^(.*)$ /tozsamosc/$1 [L]

# ── Subdomena szo-logowanie365. → bezpośrednie logowanie Microsoft 365 ──────
# Host szo-logowanie365.feer.org.pl kieruje od razu do logowania MS365.
# Tylko korzeń („/") uruchamia przekierowanie — callback OAuth
# (/auth/microsoft.php), endpoint /auth/ms365.php i strony po zalogowaniu
# (np. /portal.php) działają normalnie, bez zapętlenia.
RewriteCond %{HTTP_HOST} ^szo-logowanie365\. [NC]
RewriteRule ^$ /auth/ms365.php [L]

# ── Short / friendly URLs ───────────────────────────────────────────────────
# Aliasy krótkich linków do modułów systemu.
# Format: /alias → /moduł/  (wewnętrzny rewrite — URL zostaje w przeglądarce)

# Skróty do paneli (przekierowanie 302 — panele używają adresów względnych, więc lądujemy w ich katalogu).
# Na ti.*/kurs.*/crm.* obowiązują reguły wyżej (tam /kursant, /dydaktyk, /konsultant działają bez /karty30/ti/).
RewriteRule ^kontrahent/?$            /portal_kontrahenta/ [R=302,L]
RewriteRule ^kontrahent/(.+)$         /portal_kontrahenta/$1 [R=302,QSA,L]
RewriteRule ^(wspolpracownik|moj-panel)/?$ /panel/ [R=302,L]
RewriteRule ^start/?$                 /panel/launcher.php [R=302,L]
RewriteRule ^(eodok|dokumenty-ksiegowe)/?$ /edok/ [R=302,L]
RewriteRule ^strategia/?$             /strategy/ [R=302,L]
RewriteRule ^(ti|kursant|uczestnik)/?$ /karty30/ti/login.php [R=302,L]
RewriteRule ^dydaktyk/?$              /karty30/ti/dydaktyk/ [R=302,L]
RewriteRule ^konsultant/?$            /karty30/ti/konsultant.php [R=302,L]
RewriteRule ^rodzic/?$                /karty30/ti/kursant/parent.php [R=302,L]
RewriteRule ^slowniki/?$              /modules/dictionary/router.php [R=302,L]
RewriteRule ^administracja/?$         /admin/ [R=302,L]

RewriteRule ^katalog/?$       directory/index.php  [QSA,L]
RewriteRule ^katalog/(.+)$    directory/$1          [QSA,L]

RewriteRule ^zadania/?$       tasks/index.php       [QSA,L]
RewriteRule ^zadania/(.+)$    tasks/$1              [QSA,L]

RewriteRule ^granty/?$        grants/index.php      [QSA,L]
RewriteRule ^granty/(.+)$     grants/$1             [QSA,L]

# /dzialania → modules/strategy_actions/router.php (reguła wyżej, przed aliasami subdomen)

# Generator kont Microsoft 365 Edu (hurtowo / z listy / anonimowe)
RewriteRule ^ms/?$            modules/ms_edu_bulk/index.php [QSA,L]
RewriteRule ^ms/konta/?$      modules/ms_edu_bulk/konta.php [QSA,L]
RewriteRule ^ms/konto/?$      modules/ms_edu_bulk/konto.php [QSA,L]
RewriteRule ^ms/kreator/?$    modules/ms_edu_bulk/kreator.php [QSA,L]

RewriteRule ^osoby/?$         persons/index.php     [QSA,L]
RewriteRule ^osoby/(.+)$      persons/$1            [QSA,L]

RewriteRule ^raporty/?$       reports/index.php     [QSA,L]
RewriteRule ^raporty/(.+)$    reports/$1            [QSA,L]

RewriteRule ^procedury/?$     procedures/index.php  [QSA,L]
RewriteRule ^procedury/(.+)$  procedures/$1         [QSA,L]

RewriteRule ^tyflo/?$         karty30/index.php     [QSA,L]
RewriteRule ^tyflo/(.+)$      karty30/$1            [QSA,L]

RewriteRule ^crm/?$           crm/dashboard.php     [QSA,L]
RewriteRule ^logowanieCRM/?$  crm/login.php         [QSA,L]
RewriteRule ^crm-login/?$     crm/login.php         [QSA,L]

# Publiczne formularze lead capture: /crm/form/{slug} → crm/form/index.php (slug z adresu)
RewriteRule ^crm/form/([a-z0-9-]{1,64})/?$ /crm/form/index.php?slug=$1 [QSA,L]

RewriteRule ^vlab/?$          karty30/ti/vlab_admin.php [QSA,L]

RewriteRule ^moj-panel/?$     panel/index.php       [QSA,L]

RewriteRule ^awaryjne/?$      auth/awaryjne.php     [QSA,L]

RewriteRule ^korespondencja/?$ correspondence/index.php [QSA,L]
RewriteRule ^korespondencja/(.+)$ correspondence/$1  [QSA,L]

RewriteRule ^zasady/?$        org_intro/index.php   [QSA,L]
RewriteRule ^zasady/(.+)$     org_intro/$1           [QSA,L]

RewriteRule ^wa/?$            panel/whatsapp_group.php [QSA,L]

# Publiczna weryfikacja zaświadczeń (skan QR)
RewriteRule ^weryfikuj/?$     weryfikuj/index.php   [QSA,L]

# Publiczny asystent AI (link do udostępnienia w intranecie): /chatbot/{token}
RewriteRule ^chatbot/([a-f0-9]{16,64})/?$ chatbot/index.php?t=$1 [QSA,L]

# Dynamiczne aliasy z bazy danych (short_url_routes)
# Każdy nieznany path jest sprawdzany przez router.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(org|api|admin|auth|contracts|uploads|assets|directory|crm|karty30|tasks|grants|actions|persons|reports|procedures|panel|onboarding|org|correspondence|ezd|resolutions|chatbot|saas|saas-tenent|tenants|certs|cli|misc) [NC]
RewriteRule ^([a-z0-9_-]+)/?$ r.php?_slug=$1 [QSA,L]

# ── koniec short URLs ───────────────────────────────────────────────────────

# --- SaaS tenant routing ---
# Static uploads: /org/{slug}/uploads/... → tenants/{slug}/uploads/...
RewriteRule ^org/([a-z0-9]+)/uploads/(.+)$ tenants/$1/uploads/$2 [L]

# Tenant panel requests: /org/{slug}/{path} → /{path} with TENANT_SLUG env
# Guard: nie rewrituj jeśli plik/katalog org/ istnieje fizycznie (units/, members/, positions/)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^org/([a-z0-9]+)/(.+)$ $2 [E=TENANT_SLUG:$1,QSA,L]

# Tenant root: /org/{slug} or /org/{slug}/ → index.php with TENANT_SLUG env
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^org/([a-z0-9]+)/?$ index.php [E=TENANT_SLUG:$1,QSA,L]
# --- koniec SaaS routing ---

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Blokuj dostęp do wrażliwych plików
<FilesMatch "\.(sql|db|log|env|json|md)$">
    Require all denied
</FilesMatch>

# Blokuj dostęp do config
<Files "config.php">
    Require all denied
</Files>
<Files "config.local.php">
    Require all denied
</Files>

# Chroń katalogi wrażliwe przed bezpośrednim dostępem HTTP
# Uwaga: na Dockerze te same katalogi (+ docker/) są dodatkowo blokowane na
# poziomie VirtualHost (docker/apache.conf) — na hostingu bez kontroli nad
# głównym blokiem serwera (np. MyDevil) TYLKO poniższe reguły .htaccess
# stanowią ochronę, więc muszą pokrywać komplet katalogów.
<IfModule mod_rewrite.c>
    RewriteRule ^includes/  - [F,L]
    RewriteRule ^backups/   - [F,L]
    RewriteRule ^cron/      - [F,L]
    RewriteRule ^tenants/   - [F,L]
    RewriteRule ^docker/    - [F,L]
    RewriteRule ^cli/       - [F,L]
    RewriteRule ^bin/       - [F,L]
    RewriteRule ^vendor/    - [F,L]
</IfModule>

# Nagłówki bezpieczeństwa
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Chatbot publiczny (/chatbot/*) może być osadzony w iframe na zewnętrznych stronach.
    # Dla wszystkich pozostałych ścieżek obowiązuje SAMEORIGIN.
    SetEnvIf Request_URI "^/chatbot/" feer_chatbot_embed
    # Klauzule RODO (strona publiczna + embed.js) — osadzane w iframe na stronach zewnętrznych.
    SetEnvIf Request_URI "^/(klauzula/|modules/gdpr_clauses/public/)" feer_chatbot_embed
    Header always set X-Frame-Options "SAMEORIGIN" "env=!feer_chatbot_embed"
    Header always set Content-Security-Policy "frame-ancestors *" "env=feer_chatbot_embed"
</IfModule>

# Własne strony błędów
ErrorDocument 404 /errors/404.php
ErrorDocument 500 /errors/500.php
ErrorDocument 403 /errors/404.php
