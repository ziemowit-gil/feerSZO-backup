# Załączniki zadań serwowane WYŁĄCZNIE przez tasks/api/file.php (kontrola dostępu do obszaru).
# Bezpośredni dostęp z przeglądarki zablokowany.
Options -ExecCGI -Indexes
AddHandler cgi-script .php .pl .py
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order Deny,Allow
  Deny from all
</IfModule>
