# ── Cloudflare DNS — konfiguracja konfiguratora docker/cloudflare-dns.sh ──────
# Skopiuj: cp .env.cloudflare.example .env.cloudflare
# Ten plik zawiera sekret (token API) — NIE commituj go (jest w .gitignore).

# Token API z uprawnieniem  Zone → DNS → Edit  dla strefy ngosystem.pl
# Utwórz: https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=wklej_tutaj_token_api

# IP serwera, na który mają wskazywać rekordy (to samo IP co szo.feer.org.pl)
SERVER_IP=203.0.113.10

# (opcjonalne) Wymuś nazwę strefy — domyślnie wykrywana z hostów
# CF_ZONE=ngosystem.pl

# (opcjonalne) Lista hostów oddzielona spacją
# HOSTS=crm.ngosystem.pl zadania.ngosystem.pl ti.ngosystem.pl

# (opcjonalne) Pomarańczowa chmurka (true) lub DNS-only (false). Domyślnie true.
# PROXIED=true

# (opcjonalne) TTL w sekundach; 1 = auto (wymagane przy PROXIED=true)
# TTL=1
