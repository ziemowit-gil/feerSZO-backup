# ── DEV — zmienne środowiskowe ────────────────────────────────────────────────
# Skopiuj: cp .env.example .env
# Ten plik NIE jest wersjonowany w git.

# Porty lokalnych narzędzi deweloperskich
MAILPIT_HTTP_PORT=8025
RABBITMQ_MGMT_PORT=15672

# ── Equi Exams — silnik testów wiedzy i umiejętności (usługa `exam-engine`) ───
# Wspólny sekret wywołań PHP → Java. Wygeneruj np.: openssl rand -hex 32
# Pusty = silnik startuje bez uwierzytelniania (dopuszczalne tylko lokalnie,
# bo usługa i tak stoi w wewnętrznej sieci Dockera bez wyjścia na świat).
EXAM_ENGINE_TOKEN=
# Limity kontenera piaskownicy
EXAM_MEM_LIMIT=1g
EXAM_CPUS=1.5
EXAM_MAX_TIMEOUT_MS=15000
