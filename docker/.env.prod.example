# ── PRODUKCJA — zmienne środowiskowe ─────────────────────────────────────────
# Skopiuj: cp .env.prod.example .env.prod
# Wypełnij WSZYSTKIE wartości przed uruchomieniem.
# Ten plik NIE jest wersjonowany w git — nie commituj go!

# ── Domena i SSL ──────────────────────────────────────────────────────────────
DOMAIN=szo.feer.org.pl
ACME_EMAIL=admin@feer.org.pl      # e-mail do powiadomień Let's Encrypt

# Przekierowania ngosystem.pl → feer.org.pl (301 Permanent, obsługiwane przez Traefik).
# Subdomeny hardcodowane w docker-compose.prod.yml (nie wymagają zmiennych środowiskowych):
#   ngosystem.pl, www, szo         → https://szo.feer.org.pl
#   crm.ngosystem.pl               → https://crm.feer.org.pl  (ścieżka zachowana)
#   ti.ngosystem.pl                → https://ti.feer.org.pl   (ścieżka zachowana)
#   kurs.ngosystem.pl              → https://szo.feer.org.pl
#   zadania.ngosystem.pl           → https://szo.feer.org.pl/tasks
#   strukturaorg.ngosystem.pl      → https://strukturaorg.feer.org.pl
#   szo-logowanie365.ngosystem.pl  → https://szo-logowanie365.feer.org.pl
#   *.ngosystem.pl (pozostałe)     → https://szo.feer.org.pl
# DNS ngosystem.pl musi wskazywać na IP serwera (rekord A lub przez Cloudflare proxy).

# ── Aplikacja ─────────────────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://szo.feer.org.pl

# Wygeneruj nowy klucz: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=WKLEJ_TUTAJ_64_ZNAKOWY_HEX_APP_KEY

ORG_NAME=Fundacja Edukacji Empatii Rozwoju FEER

# ── Baza danych ───────────────────────────────────────────────────────────────
# SQLite (domyślne — bez MySQL):
DB_TYPE=sqlite

# MySQL — odkomentuj i wypełnij jeśli używasz docker-compose.mysql.yml:
# DB_TYPE=mysql
# DB_HOST=mysql
# DB_PORT=3306
# DB_NAME=feer
# DB_USER=feer
# DB_PASS=ZMIEN_TO_HASLO_MYSQL
# MYSQL_ROOT_PASSWORD=ZMIEN_TO_HASLO_ROOT

# ── SMTP (fallback dla mail() — opcjonalne jeśli używasz Graph API) ───────────
# Wartości dla SMTP_TLS: off (brak TLS), tls (SSL port 465), starttls (port 587)
# Przykład dla M365 SMTP Auth:
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_FROM=no-reply@feer.org.pl
# SMTP_USER=no-reply@feer.org.pl
# SMTP_PASS=ZMIEN_TO_HASLO_SMTP
# SMTP_TLS=starttls

# ── Microsoft 365 ─────────────────────────────────────────────────────────────
MS_ENABLED=1
MS_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MS_CLIENT_SECRET=twoj_client_secret_azure
MS_REDIRECT_URI=https://szo.feer.org.pl/auth/microsoft.php

# ── EJBCA (urząd certyfikacji) — odkomentuj jeśli używasz docker-compose.ejbca.yml
# Zob. docker/EJBCA.md po szczegóły pierwszego uruchomienia.
# CA_DOMAIN=ca.feer.org.pl
#
# Wygeneruj sekrety: openssl rand -hex 32
# EJBCA_PASSWORD_ENCRYPTION_KEY=ZMIEN_TO_64_ZNAKOWY_HEX
# EJBCA_CA_KEYSTOREPASS=ZMIEN_TO_64_ZNAKOWY_HEX
# EJBCA_DB_PASSWORD=ZMIEN_TO_HASLO_EJBCA_DB
# EJBCA_DB_ROOT_PASSWORD=ZMIEN_TO_HASLO_ROOT_EJBCA_DB
