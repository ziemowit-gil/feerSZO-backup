<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/feer_sync/db" VERSION="20260603" COMMENT="XMLDB file for local_feer_sync">
  <TABLES>

    <!--
      Mapa: adres e-mail wolontariusza ↔ Moodle user ID.
      Pozwala unikać ponownych wywołań find_user przy każdej synchronizacji.
    -->
    <TABLE NAME="local_feer_sync_users" COMMENT="FEER volunteer → Moodle user mapping">
      <FIELDS>
        <FIELD NAME="id"              TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="feer_id"         TYPE="int"  LENGTH="10" NOTNULL="false" COMMENT="ID umowy w FEER (umowy_wolontariat.id)"/>
        <FIELD NAME="email"           TYPE="char" LENGTH="200" NOTNULL="true"/>
        <FIELD NAME="moodle_user_id"  TYPE="int"  LENGTH="10" NOTNULL="false"/>
        <FIELD NAME="feer_status"     TYPE="char" LENGTH="50"  NOTNULL="false" COMMENT="Ostatni znany status z FEER"/>
        <FIELD NAME="action_id"       TYPE="int"  LENGTH="10"  NOTNULL="false" COMMENT="ID działania z FEER"/>
        <FIELD NAME="synced_at"       TYPE="int"  LENGTH="10"  NOTNULL="false" COMMENT="Unix timestamp ostatniej synchronizacji"/>
        <FIELD NAME="created_at"      TYPE="int"  LENGTH="10"  NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="email_unique" TYPE="unique" FIELDS="email"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="idx_moodle_user" UNIQUE="false" FIELDS="moodle_user_id"/>
        <INDEX NAME="idx_feer_id"     UNIQUE="false" FIELDS="feer_id"/>
      </INDEXES>
    </TABLE>

    <!-- Dziennik synchronizacji -->
    <TABLE NAME="local_feer_sync_log" COMMENT="FEER sync run log">
      <FIELDS>
        <FIELD NAME="id"           TYPE="int"  LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="timecreated"  TYPE="int"  LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="trigger"      TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="manual" COMMENT="manual|scheduled"/>
        <FIELD NAME="status"       TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="ok" COMMENT="ok|error"/>
        <FIELD NAME="fetched"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="created"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="updated"      TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="suspended"    TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="errors"       TYPE="int"  LENGTH="10" NOTNULL="true" DEFAULT="0"/>
        <FIELD NAME="message"      TYPE="text" NOTNULL="false"/>
        <FIELD NAME="details"      TYPE="text" NOTNULL="false" COMMENT="JSON array z detalami każdej operacji"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>

  </TABLES>
</XMLDB>
