            catch (\Throwable $e) { $__actions = []; } ?>
      <select name="action_id" id="action_id_select" class="form-select ts-action">
        <option value="">— brak —</option>
        <?php foreach ($__actions as $a):
          $sel = ($row['action_id']??'')==$a['id']?'selected':''; ?>
