<script>
// ── Helpers ──────────────────────────────────────────────────────────────────
function peselToBirthdate(p) {
  if (p.length !== 11) return '';
  var y=parseInt(p.substr(0,2),10), m=parseInt(p.substr(2,2),10), d=parseInt(p.substr(4,2),10);
  if(m>=81){y+=1800;m-=80;} else if(m>=61){y+=2200;m-=60;}
  else if(m>=41){y+=2100;m-=40;} else if(m>=21){y+=2000;m-=20;} else{y+=1900;}
  if(m<1||m>12||d<1||d>31) return '';
  return y+'-'+String(m).padStart(2,'0')+'-'+String(d).padStart(2,'0');
}
function peselGender(p) {
  if (p.length !== 11) return null;
  return parseInt(p[9],10) % 2 === 0 ? 'K' : 'M';
}
function ageFromDate(dateStr) {
  if (!dateStr) return null;
  var b = new Date(dateStr), now = new Date();
  var age = now.getFullYear() - b.getFullYear();
  if (now < new Date(now.getFullYear(), b.getMonth(), b.getDate())) age--;
  return age;
}

// ── PESEL → data urodzenia + płeć ────────────────────────────────────────────
(function () {
  var peselIn = document.getElementById('f_pesel');
  var dateIn  = document.getElementById('f_data_urodzenia');
  var hint    = document.getElementById('peselDateHint');
  var badge   = document.getElementById('pesel_gender_badge');
  if (!peselIn) return;

  peselIn.addEventListener('input', function () {
    var p = this.value.replace(/\D/g,'');
    // Data urodzenia
    if (p.length === 11) {
      var bd = peselToBirthdate(p);
      if (bd && !dateIn.value) {
        dateIn.value = bd;
        if (hint) hint.style.display = '';
      }
      // Płeć
      var g = peselGender(p);
      if (badge) {
        badge.textContent = g === 'K' ? '♀ Kobieta' : '♂ Mężczyzna';
        badge.className = 'badge ms-1 ' + (g === 'K' ? 'bg-pink text-white' : 'bg-info text-white');
        badge.style.display = '';
      }
    } else {
      if (badge) badge.style.display = 'none';
    }
    updateSummary();
  });
})();

// ── Wiek w podglądzie ─────────────────────────────────────────────────────────
function updateSummary() {
  function val(name) {
    var el = document.querySelector('[name="'+name+'"]');
    if (!el) return '';
    return (el.tagName==='SELECT' ? el.options[el.selectedIndex]?.text : el.value).trim();
  }
  var bezterm = document.getElementById('bezterminowa')?.checked;
  var wiek = ageFromDate(val('data_urodzenia'));

  document.getElementById('sum-name').textContent    = val('imie_nazwisko') || '—';
  document.getElementById('sum-pesel').textContent   = val('pesel') || '—';
  document.getElementById('sum-email').textContent   = val('email') || '—';
  document.getElementById('sum-telefon').textContent = val('telefon') ? '+48 '+val('telefon') : '—';
  document.getElementById('sum-status').textContent  = val('status') || '—';
  document.getElementById('sum-data-zawarcia').textContent = val('data_zawarcia') || '—';
  document.getElementById('sum-okres').textContent   =
    (val('data_rozpoczecia')||'?') + ' → ' + (bezterm ? '∞' : (val('data_zakonczenia')||'?'));
  document.getElementById('sum-projekt').textContent = val('projekt_program') || '—';
  document.getElementById('sum-wiek').textContent    = wiek !== null ? wiek + ' lat' : '—';
}
document.querySelectorAll('input,select,textarea').forEach(function(el) {
  el.addEventListener('input', updateSummary);
  el.addEventListener('change', updateSummary);
});
updateSummary();

// ── Warunkowe pola ────────────────────────────────────────────────────────────
// ── Status terminalny → uzasadnienie ─────────────────────────────────────────
(function () {
  var statusSel   = document.getElementById('status_select');
  var uzSection   = document.getElementById('uzasadnienie_section');
  var uzTextarea  = document.getElementById('uzasadnienie_statusu');
  var uzLabel     = document.getElementById('uzasadnienie_status_label');
  var terminal    = <?= json_encode($_terminal_statuses) ?>;
  if (!statusSel || !uzSection) return;

  function updateUzasadnienie() {
    var v = statusSel.value;
    var isTerminal = terminal.includes(v);
    uzSection.style.display = isTerminal ? '' : 'none';
    if (uzTextarea) uzTextarea.required = isTerminal;
    if (uzLabel) uzLabel.textContent = isTerminal ? '(status: ' + v + ')' : '';
  }
  statusSel.addEventListener('change', updateUzasadnienie);
  updateUzasadnienie();
})();

document.getElementById('forma_podpisania')?.addEventListener('change', function() {
  var v = this.value;
  document.getElementById('el_fields').style.display      = v==='elektroniczna' ? '' : 'none';
  document.getElementById('epodpis_fields').style.display = v==='epodpis_kwalifikowany' ? '' : 'none';
});
document.getElementById('niepelnoletni')?.addEventListener('change', function() {
  document.getElementById('rodzic_section').style.display = this.checked ? '' : 'none';
});
document.getElementById('bezterminowa')?.addEventListener('change', function() {
  var dz = document.getElementById('data_zakonczenia');
  dz.disabled = this.checked;
  if (this.checked) dz.value = '';
  updateSummary();
});
document.getElementById('zwrot_kosztow')?.addEventListener('change', function() {
  document.getElementById('zwrot_kosztow_opis_field').style.display = this.checked ? '' : 'none';
});
document.getElementById('szkolenie_bhp')?.addEventListener('change', function() {
  document.getElementById('data_szkolenia_bhp').disabled = !this.checked;
});
document.getElementById('ubezpieczenie_nnw')?.addEventListener('change', function() {
  document.getElementById('numer_polisy_nnw').disabled = !this.checked;
});
document.getElementById('z_webngo')?.addEventListener('change', function() {
  document.getElementById('webngo_fields').style.display = this.checked ? '' : 'none';
  if (!this.checked) {
    document.getElementById('webngo_id').value = '';
    document.getElementById('webngo_numer_umowy').value = '';
  }
});

// ── M365 tryb ────────────────────────────────────────────────────────────────
(function () {
  var radios = document.querySelectorAll('[name="m365_create_mode"]');
  var manual = document.getElementById('m365_manual_fields');
  function update() {
    var val = document.querySelector('[name="m365_create_mode"]:checked')?.value;
    if (manual) manual.style.display = val === 'manual' ? '' : 'none';
  }
  radios.forEach(function(r) { r.addEventListener('change', update); });
  update();
})();
</script>

<style>
@keyframes fillPulse { 0%{box-shadow:0 0 0 0 rgba(25,135,84,.45)} 70%{box-shadow:0 0 0 8px rgba(25,135,84,0)} 100%{box-shadow:none} }
.autofilled { animation: fillPulse .8s ease }
</style>
<link href="https://cdn.jsdelivr.net/npm/tom-select@2/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/tom-select@2/dist/js/tom-select.complete.min.js"></script>
<script>
['ts-action','ts-grant'].forEach(function(cls) {
  var el = document.querySelector('.' + cls);
  if (!el) return;
  var ts = new TomSelect(el, { allowEmptyOption: true });
  // Projekt/program ← nazwa działania
  if (cls === 'ts-action') {
    ts.on('change', function(val) {
      var pp = document.querySelector('[name="projekt_program"]');
      if (!pp) return;
      if (!val) return; // brak wyboru — nie czyść
      var opt = document.querySelector('[name="action_id"] option[value="' + val + '"]');
      var nazwa = opt ? (opt.dataset.nazwa || opt.textContent.trim()) : '';
      if (nazwa && !pp.value.trim()) {
        pp.value = nazwa;
        pp.classList.add('autofilled');
        setTimeout(function() { pp.classList.remove('autofilled'); }, 800);
        updateSummary();
      }
    });
  }
});
</script>

<script>
// ── PESEL / Obcokrajowiec + wiek + CPC meta ─────────────────────────────────
(function () {
  'use strict';

  // ── Przełącznik tożsamości ────────────────────────────────────────────────
  var radios     = document.querySelectorAll('input[name="identity_type"]');
  var secPesel   = document.getElementById('section_pesel');
  var secPeselD  = document.getElementById('section_pesel_dob');
  var secFor     = document.getElementById('section_foreigner');

  function toggleIdentity(val) {
    var isPesel = val === 'pesel';
    [secPesel, secPeselD].forEach(function (el) {
      if (!el) return;
      el.classList.toggle('d-none', !isPesel);
    });
    if (secFor) secFor.classList.toggle('d-none', isPesel);

    // Wymagane pola
    var peselInp = document.getElementById('f_pesel');
    if (peselInp) peselInp.required = isPesel;
    var docType = document.getElementById('f_id_doc_type');
    var docNum  = document.getElementById('f_id_doc_number');
    if (docType) docType.required = !isPesel;
    if (docNum)  docNum.required  = !isPesel;
  }

  radios.forEach(function (r) {
    r.addEventListener('change', function () { toggleIdentity(this.value); });
  });
  // Inicjalizacja
  var checkedRadio = document.querySelector('input[name="identity_type"]:checked');
  if (checkedRadio) toggleIdentity(checkedRadio.value);

  // ── PESEL: walidacja sumy kontrolnej i wiek ───────────────────────────────
  var CURRENT_YEAR = 2026;
  var WEIGHTS = [1, 3, 7, 9, 1, 3, 7, 9, 1, 3];

  function peselChecksum(p) {
    if (p.length !== 11) return false;
    var digits = p.split('').map(Number);
    var sum = 0;
    for (var i = 0; i < 10; i++) sum += digits[i] * WEIGHTS[i];
    var check = (10 - (sum % 10)) % 10;
    return check === digits[10];
  }

  function peselBirthYear(p) {
    if (p.length < 6) return null;
    var y = parseInt(p.substr(0, 2), 10);
    var m = parseInt(p.substr(2, 2), 10);
    if      (m >= 81 && m <= 92)  { y += 1800; }
    else if (m >= 21 && m <= 32)  { y += 2000; }
    else if (m >= 41 && m <= 52)  { y += 2100; }
    else if (m >= 61 && m <= 72)  { y += 2200; }
    else                           { y += 1900; }
    return y;
  }

  function peselAge(p) {
    var birthYear = peselBirthYear(p);
    if (!birthYear) return null;
    return CURRENT_YEAR - birthYear;
  }

  function peselToDate(p) {
    if (p.length < 6) return '';
    var y = parseInt(p.substr(0, 2), 10);
    var m = parseInt(p.substr(2, 2), 10);
    var d = parseInt(p.substr(4, 2), 10);
    if      (m >= 81) { y += 1800; m -= 80; }
    else if (m >= 61) { y += 2200; m -= 60; }
    else if (m >= 41) { y += 2100; m -= 40; }
    else if (m >= 21) { y += 2000; m -= 20; }
    else               { y += 1900; }
    if (m < 1 || m > 12 || d < 1 || d > 31) return '';
    return y + '-' + String(m).padStart(2, '0') + '-' + String(d).padStart(2, '0');
  }

  var peselInp   = document.getElementById('f_pesel');
  var peselErr   = document.getElementById('pesel_error');
  var peselAgeEl = document.getElementById('pesel_age_info');
  var peselHint  = document.getElementById('peselDateHint');
  var dobInp     = document.getElementById('f_data_urodzenia');
  var minorChk   = document.getElementById('niepelnoletni');
  var rodzicSec  = document.getElementById('rodzic_section');

  if (peselInp) {
    peselInp.addEventListener('input', function () {
      var p = this.value.replace(/\D/g, '').substr(0, 11);
      this.value = p;
      peselInp.classList.remove('is-valid', 'is-invalid');
      peselAgeEl.textContent = '';

      if (p.length === 11) {
        if (peselChecksum(p)) {
          peselInp.classList.add('is-valid');
          var age   = peselAge(p);
          var bd    = peselToDate(p);
          var minor = age !== null && age < 18;

          if (age !== null) {
            peselAgeEl.innerHTML = '<span class="badge ' + (minor ? 'bg-warning text-dark' : 'bg-success') + '">'
              + age + ' lat — ' + (minor ? 'Nieletni/a' : 'Pełnoletni/a') + '</span>';
          }

          // Auto-fill data urodzenia
          if (bd && dobInp && !dobInp.value) {
            dobInp.value = bd;
            if (peselHint) peselHint.style.display = '';
          }

          // Auto-toggle niepełnoletni
          if (minorChk) {
            minorChk.checked = minor;
            if (rodzicSec) {
              rodzicSec.style.display = minor ? '' : 'none';
              // Ustaw required dla danych rodzica
              rodzicSec.querySelectorAll('input[name="rodzic_imie_nazwisko"], input[name="rodzic_email"], input[name="rodzic_telefon"]')
                .forEach(function (f) { f.required = minor; });
            }
          }

        } else {
          peselInp.classList.add('is-invalid');
          peselAgeEl.textContent = '';
        }
      }
    });
  }

  // ── Guardian initials display + auto-fill opiekun hidden ─────────────────
  var guardianSel  = document.getElementById('guardian_editor_id');
  var guardianHint = document.getElementById('guardian_initials_hint');
  var guardianInp  = document.getElementById('guardian_initials_inp');
  var opiekunHid   = document.getElementById('opiekun_hidden');

  if (guardianSel) {
    guardianSel.addEventListener('change', function () {
      var opt      = this.options[this.selectedIndex];
      var initials = opt ? (opt.dataset.initials || '') : '';
      var name     = opt ? (opt.dataset.name     || '') : '';
      if (guardianHint) {
        if (initials) {
          guardianHint.innerHTML =
            '<span class="d-inline-flex align-items-center gap-2 mt-1">'
            + '<span class="badge rounded-pill bg-primary-subtle text-primary border border-primary-subtle px-3 py-2" style="font-size:.82rem">'
            + '<i class="bi bi-person-badge me-1"></i>'
            + 'Inicjały na umowie: <strong class="font-monospace ms-1">' + initials + '</strong>'
            + '</span>'
            + '<span class="text-muted small">' + name + '</span>'
            + '</span>';
        } else {
          guardianHint.innerHTML =
            '<span class="text-muted small">'
            + '<i class="bi bi-info-circle me-1"></i>'
            + 'Osoba odpowiedzialna — jej inicjały trafiają do nr rejestru i autoryzacji CPC.'
            + '</span>';
        }
      }
      if (guardianInp) guardianInp.value = initials;
      // Synchronizuj opiekun (tekst) z wybranym edytorem — dla nr_rejestru
      if (opiekunHid) opiekunHid.value = name;
    });
    // Trigger on load
    guardianSel.dispatchEvent(new Event('change'));
  }

  // ── Szybkie ustawianie dat ────────────────────────────────────────────────
  window._setDate = function(fieldName, offsetDays) {
    var d = new Date();
    d.setDate(d.getDate() + (offsetDays || 0));
    var iso = d.getFullYear() + '-'
            + String(d.getMonth() + 1).padStart(2, '0') + '-'
            + String(d.getDate()).padStart(2, '0');
    var inputs = document.querySelectorAll('[name="' + fieldName + '"]');
    inputs.forEach(function (inp) { inp.value = iso; });
    updateSummary();
  };

  // ── Kopiuj adres zamieszkania → korespondencyjny ──────────────────────────
  window._copyToCorrespondence = function() {
    var w = document.getElementById('mainAddrWidget');
    if (!w) return;

    function gv(name) {
      var el = w.querySelector('[name="' + name + '"]');
      return el ? el.value.trim() : '';
    }
    function sv(name, val) {
      var el = document.querySelector('input[name="' + name + '"], select[name="' + name + '"]');
      if (el) { el.value = val; el.classList.add('autofilled'); setTimeout(function(){el.classList.remove('autofilled');},800); }
    }

    var street  = gv('addr_street');
    var house   = gv('addr_house');
    var flat    = gv('addr_flat');
    var postal  = gv('addr_postal');
    var city    = gv('addr_city');
    var country = gv('addr_country');

    var linia1 = [street, house + (flat ? '/' + flat : '')].filter(Boolean).join(' ');

    // Odbiorca — imię i nazwisko wolontariusza
    var nameEl = document.getElementById('f_imie_nazwisko');
    sv('adres_odbiorca', nameEl ? nameEl.value : '');
    sv('adres_linia1',   linia1);
    sv('adres_linia2',   '');
    sv('adres_kod_pocztowy', postal);
    sv('adres_miasto',   city);
    sv('adres_kraj',     country || 'PL');

    // Rozwiń sekcję korespondencyjną jeśli zwinięta
    var corrBody = document.getElementById('adres_corr_body');
    if (corrBody && !corrBody.classList.contains('show')) {
      var bsCollapse = bootstrap.Collapse.getOrCreateInstance(corrBody);
      bsCollapse.show();
    }
  };

})();

</script>

<?php include dirname(dirname(__DIR__)) . '/includes/footer.php'; ?>
